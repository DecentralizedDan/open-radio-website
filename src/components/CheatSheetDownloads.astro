---
import { cheatSheetDownloadLinks } from '../lib/downloads';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const downloads = cheatSheetDownloadLinks(slug);
---

<div class="download-actions">
  {
    downloads.map((download) => (
      <a
        class={`btn ${download.primary ? 'btn-primary' : 'btn-secondary'}`}
        href={download.href}
        download
        {...(download.title ? { title: download.title } : {})}
      >
        {download.label}
      </a>
    ))
  }
</div>
