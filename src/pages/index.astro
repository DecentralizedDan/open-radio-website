---
import PageLayout from '../layouts/PageLayout.astro';
import PathDiagram from '../components/PathDiagram.astro';
import CheatSheetCard from '../components/CheatSheetCard.astro';
import UnitCard from '../components/UnitCard.astro';
import {
  site,
  activities,
  cheatSheets,
  phoneTrack,
  digitalTrack,
} from '../data/curriculum';
import { url } from '../lib/paths';

const featuredWorkshops = [...phoneTrack, ...digitalTrack].filter((u) => u.featured);
const featuredActivitySlugs = [
  'fox-hunt',
  'radio-practical-skills',
  'how-to-host-a-neighborhood-net',
];
const featuredActivities = featuredActivitySlugs.map((slug) =>
  activities.find((u) => u.slug === slug),
).filter((u): u is NonNullable<typeof u> => u !== undefined);
const featuredCheatSheetSlugs = [
  'radio-etiquette',
  'uhf-vhf-ham',
  'amateur-digital-operation',
  'hf-phone',
];
const featuredCheatSheets = featuredCheatSheetSlugs.map((slug) =>
  cheatSheets.find((s) => s.slug === slug),
).filter((s): s is NonNullable<typeof s> => s !== undefined);
---

<PageLayout title={site.name} description={site.description} current="home">
  <section class="hero">
    <div class="container">
      <h1>{site.tagline}</h1>
      <p class="lead">{site.description}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={url('/start/for-trainers/')}>I want to teach</a>
        <a class="btn btn-secondary" href={url('/start/for-learners/')}>For learners</a>
        <a class="btn btn-secondary" href={url('/curriculum/')}>Browse curriculum</a>
      </div>
      <div class="number-strip" aria-label="Curriculum at a glance">
        <span><strong>10</strong> workshops</span>
        <span><strong>5</strong> activities</span>
        <span><strong>0</strong> licenses required to start</span>
      </div>
      <PathDiagram />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Featured workshops</h2>
      <p>These can be offered in linear courses or as one-off workshops.</p>
      <div class="card-grid card-grid-3" style="margin-top: 1.25rem;">
        {featuredWorkshops.map((unit) => <UnitCard unit={unit} />)}
      </div>
      <p style="margin-top: 1.25rem;">
        <a href={url('/curriculum/')}>View all 10 workshops →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Featured activities</h2>
      <p>Standalone fun activities for radio novices and veterans alike.</p>
      <div class="card-grid card-grid-3" style="margin-top: 1.25rem;">
        {featuredActivities.map((unit) => <UnitCard unit={unit} />)}
      </div>
      <p style="margin-top: 1.25rem;">
        <a href={url('/curriculum/activities/')}>View all 5 activities →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Featured cheat sheets</h2>
      <p>Quick-reference cards: Made to print, laminate and share.</p>
      <div class="cheat-sheet-grid" style="margin-top: 1.25rem;">
        {featuredCheatSheets.map((sheet) => <CheatSheetCard sheet={sheet} />)}
      </div>
      <p style="margin-top: 1.25rem;">
        <a href={url('/reference/cheat-sheets/')}>View all 6 cheat sheets →</a>
      </p>
    </div>
  </section>
</PageLayout>
